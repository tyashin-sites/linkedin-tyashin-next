{
  // Worker name — keep identical to the workerScriptName passed to /adopt.
  "name": "site-linkedin-tyashin-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    // PLACEHOLDER — replace with the KV namespace id before the first deploy
    // (`npx wrangler kv namespace create NEXT_INC_CACHE_KV`, or the platform's
    // shared namespace). The binding name MUST stay NEXT_INC_CACHE_KV.
    { "binding": "NEXT_INC_CACHE_KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  // ISR revalidation queue (open-next.config.ts `queue: doQueue`).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "site-linkedin-tyashin-next" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "TYASHIN_API_URL": "https://website-api.tyashin.com",
    // Indexing switch. "true" until cutover. Prerendered pages bake this at
    // BUILD time, so export ROBOTS_NOINDEX in the build env too and rebuild.
    "ROBOTS_NOINDEX": "true",
    "NEXT_PUBLIC_SITE_DOMAIN": "linkedinautomation.tyashin.com"
  }
  // Secrets (set by the platform's deploy workflow, never committed):
  //   TYASHIN_API_KEY, PROJECT_ID
}
