# All optional — the site builds and renders with every one of these unset.
TYASHIN_API_KEY=            # project storefront key (server-only; forms, blog, legal)
TYASHIN_API_URL=https://website-api.tyashin.com
PROJECT_ID=                 # Tyashin project id
NEXT_PUBLIC_SITE_DOMAIN=linkedin.tyashin.com   # canonical host (no protocol)
NEXT_PUBLIC_APP_URL=https://linkedin.tyashin.com   # where /signup/ and /login/ live
TYASHIN_SLUG_HOST=          # https://<slug>.sites.tyashin.com (workers.dev rewrites only)
ROBOTS_NOINDEX=true         # "false" for the production build
